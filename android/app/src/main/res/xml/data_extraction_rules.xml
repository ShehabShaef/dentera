<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the per-install sentinel so reinstall can detect preserved backed-up data. -->
        <exclude domain="file" path="dentera_install_verified" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="dentera_install_verified" />
    </device-transfer>
</data-extraction-rules>
